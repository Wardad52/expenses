#!/usr/bin/env bash
# auto-import new receipt JPGs -> ezBookkeeping (tesseract OCR, heuristic parse)
set -uo pipefail
BASE="/home/warren/Projects/Financal plugin-workspace/assets/receipts/2026 Receipts"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/warren.expenses"
CONF="$DATA/ez.conf"; LOG="$DATA/auto-import.log"; SEEN="$DATA/processed.dat"
ATTN="$DATA/needs-attention.log"
# duplicate receipt names: current set + re-nag pacing
DUPES="$DATA/dupes.log"; DUPNEW="$DATA/dupes.current"; NAG="$DATA/dupes-last-nag"
NAG_EVERY=300   # seconds — re-notify about existing duplicates every 5 minute-ticks
[ -f "$CONF" ] && . "$CONF"
: "${EBK_TOKEN:?run expenses set-token first}"
mkdir -p "$DATA"; touch "$SEEN"; : > "$ATTN.tmp"; : > "$DUPNEW"
ACCT="3846510145777434624"
declare -A CATS=( ["Food & Drink"]="3846513861192581120" ["Clothing & Apparel"]="3846513219094970382" ["Housing & Houseware"]="3846513219094970386" ["Transportation"]="3846513219094970394" ["Auto/Fuel"]="3846514795347968000" ["Vacation"]="3846528251480506368" ["Coms"]="3846513219094970397" ["Entertainment"]="3846513219094970402" ["Education"]="3846513219094970408" ["Gifts & Donate"]="3846513219094970410" ["Medical"]="3846513219094970412" ["Finance & Insurance"]="3846513219094970417" ["Misc"]="3846514795347968002" )
TZNAME="America/Anchorage"; TZOFF="-480"
EBK_URL="${EBK_URL:-http://localhost:9400}"
log(){ echo "$(date -Is) $*" >> "$LOG"; }
attn(){ echo "$1" >> "$ATTN.tmp"; log "NEEDS-REVIEW $1"; }
while IFS= read -r f; do
  # same receipt name already filed in a month folder -> flag & skip it here
  b=$(basename "$f")
  dup=""
  for d in "$BASE"/*" Receipts"*/; do
    if [ -e "$d/$b" ]; then dup="${d%/}"; break; fi
  done
  if [ -n "$dup" ]; then
    echo "$b|$(basename "$dup")" >> "$DUPNEW"
    continue
  fi
  grep -qxF "$f" "$SEEN" && continue
  # PDFs: render first page to JPG for OCR + upload (ez only takes images)
  src="$f"
  if [[ "$f" =~ \.[Pp][Dd][Ff]$ ]]; then
    rm -f /tmp/ez-pdf.jpg
    if pdftoppm -jpeg -r 200 -f 1 -l 1 "$f" /tmp/ez-pdf 2>/dev/null && [ -f /tmp/ez-pdf-1.jpg ]; then
      mv /tmp/ez-pdf-1.jpg /tmp/ez-pdf.jpg; src="/tmp/ez-pdf.jpg"
      log "PDF-RENDER $f -> $src"
    else
      attn "$(basename "$f") PDF could not be rendered — left top-level"
      log "FAILED $f pdftoppm render failed"
      echo "$f" >> "$SEEN"; continue
    fi
  else
    # bake EXIF rotation into pixels so tesseract sees upright text
    command -v mogrify >/dev/null 2>&1 && mogrify -auto-orient "$f" 2>/dev/null || true
  fi
  txt=$(tesseract "$src" stdout 2>/dev/null || true)
  # date: first MM/DD/YY(YY) match
  dt=$(echo "$txt" | grep -oE '[0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4}' | head -1)
  datestr=""
  if [ -n "$dt" ]; then
    m=${dt%%/*}; rest=${dt#*/}; d=${rest%%/*}; y=${rest#*/}
    [ ${#y} -eq 2 ] && y="20$y"
    # force base-10: leading-zero 08/09 are invalid octal to printf
    m=$((10#$m)); d=$((10#$d)); y=$((10#$y))
    if [ "$m" -ge 1 ] 2>/dev/null && [ "$m" -le 12 ] 2>/dev/null && [ "$d" -ge 1 ] 2>/dev/null && [ "$d" -le 31 ] 2>/dev/null; then
      datestr=$(printf "%s-%02d-%02d" "$y" "$m" "$d")
    fi
  fi
  if [ -z "$datestr" ]; then datestr=$(stat -c %y "$f" | cut -d' ' -f1); log "DATE-FALLBACK $f -> $datestr"; fi
  # hard validation: reject impossible dates (e.g. day 00 from OCR garbage) -> file mtime
  if ! date -d "$datestr 12:00" +%s >/dev/null 2>&1; then datestr=$(stat -c %y "$f" | cut -d' ' -f1); log "DATE-INVALID-FALLBACK $f -> $datestr"; fi
  # amount: largest $ value near total/balance, else max
  amt=$(echo "$txt" | grep -oiE '(total|balance|amount)[^0-9]*\$? ?[0-9]{1,4}\.[0-9]{2}' | grep -oE '[0-9]{1,4}\.[0-9]{2}' | sort -t. -k1,1n | tail -1)
  [ -z "$amt" ] && amt=$(echo "$txt" | grep -oE '[0-9]{1,4}\.[0-9]{2}' | sort -t. -k1,1n | tail -1)
  store=$(echo "$txt" | head -5 | tr '\n' ' ' | cut -c1-60 | sed 's/[^A-Za-z0-9 &.-]/ /g')
  [ -z "$store" ] && store="Receipt"
  cat="Misc"
  low=$(echo "$txt" | head -20 | tr 'A-Z' 'a-z')
  if echo "$low" | grep -qiE 'fuel|gas|chevron|shell'; then cat="Auto/Fuel"
  elif echo "$low" | grep -qiE 'pizza|restaurant|bakery|cafe|dining|cane|tooth'; then cat="Food & Drink"
  elif echo "$low" | grep -qiE 'costco|fred|meyer|target|bears|market|groc'; then cat="Food & Drink"
  fi
  needs_review=""
  if [ -z "$amt" ]; then amt="0.00"; needs_review=" NEEDS-REVIEW"; log "AMOUNT-FALLBACK $f -> 0.00 (will review in ezBookkeeping)"; fi
  cents=$(python3 -c "print(int(round(float('$amt')*100)))")
  ts=$(date -d "$datestr 12:00" +%s)
  # upload photo first (API needs lowercase extension)
  cp "$src" /tmp/ez-up.jpg
  up=$(curl -s -H "Authorization: Bearer $EBK_TOKEN" -X POST "$EBK_URL/api/v1/transaction/pictures/upload.json" -F "picture=@/tmp/ez-up.jpg")
  pid=$(echo "$up" | python3 -c "import json,sys; print(json.load(sys.stdin).get('result',{}).get('pictureId',''))" 2>/dev/null)
  if [ -n "$pid" ]; then picjson=",\"pictureIds\":[\"$pid\"]"; else picjson=""; fi
  resp=$(curl -s -H "Authorization: Bearer $EBK_TOKEN" -H "Content-Type: application/json" -H "X-Timezone-Name: $TZNAME" -H "X-Timezone-Offset: $TZOFF" -X POST "$EBK_URL/api/v1/transactions/add.json" -d "{\"type\":3,\"categoryId\":\"${CATS[$cat]}\",\"time\":$ts,\"utcOffset\":-480,\"sourceAccountId\":\"$ACCT\",\"sourceAmount\":$cents$picjson,\"comment\":\"$store $datestr (auto$needs_review)\"}")
  if echo "$resp" | grep -q '"success":true'; then
    log "IMPORTED $f $datestr $store $amt $cat$needs_review"
    [ -n "$needs_review" ] && attn "$(basename "$f") imported as $amt — review amount in ezBookkeeping"
    mon=$(date -d "$datestr" +"%b Receipts")
    mkdir -p "$BASE/$mon" && mv "$f" "$BASE/$mon/" 2>/dev/null || true
  else
    attn "$(basename "$f") ezBookkeeping rejected it ($datestr $store $amt) — left top-level"
    log "FAILED $f $resp"
  fi
  echo "$f" >> "$SEEN"
done < <(find "$BASE" -maxdepth 1 \( -iname "*.jpg" -o -iname "*.pdf" \) | sort)
# notify if anything needs attention
if [ -s "$ATTN.tmp" ]; then
  mv "$ATTN.tmp" "$ATTN"
  n=$(wc -l < "$ATTN")
  first=$(head -1 "$ATTN")
  notify-send -u critical "Expenses: $n receipt(s) need attention" "$first" 2>/dev/null || true
else
  rm -f "$ATTN.tmp"
  : > "$ATTN"
fi
# duplicate-name report: re-notify every NAG_EVERY seconds while a dup sits in the queue
if [ -s "$DUPNEW" ]; then
  mv "$DUPNEW" "$DUPES"
  sort -u -o "$DUPES" "$DUPES"
else
  rm -f "$DUPNEW"
  : > "$DUPES"
fi
if [ -s "$DUPES" ]; then
  line=$(head -1 "$DUPES")
  msg="${line%%|*} is already filed in ${line#*|}"
  extra=$(( $(wc -l < "$DUPES") - 1 ))
  [ "$extra" -gt 0 ] && msg="$msg (+$extra more)"
  now=$(date +%s); last=$(cat "$NAG" 2>/dev/null || echo 0)
  if [ $(( now - last )) -ge "$NAG_EVERY" ]; then
    log "DUPLICATE-NAME nag: $msg"
    # Persistent toast: left-click opens the 2026 Receipts folder in Omafile,
    # right-click dismisses. Critical urgency = the shell never auto-expires it.
    omarchy-notification-send -u critical --app-name "Expenses" \
      "Expenses: duplicate receipt name(s)" \
      "$msg — left-click: open folder · right-click: dismiss" \
      --exec "$HOME/.config/omarchy/plugins/xyzlab.omafile/bin/omafile-open" "$BASE" >/dev/null 2>&1 ||
      notify-send -u normal "Expenses: duplicate receipt name(s)" "$msg" 2>/dev/null || true
    echo "$now" > "$NAG"
  fi
else
  rm -f "$NAG"
fi
echo "done, see $LOG"
